PORT=5001
JWT_SECRET=your_jwt_secret_key
NODE_ENV=development

# --- Storage Options ---
# Option 1: Upstash Redis (For chats and profiles)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Option 2: MongoDB (Optional)
MONGO_URI=

# If neither is set, ChatMe runs in-memory with pre-seeded demo accounts!
